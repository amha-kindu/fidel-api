# Environment
ENV=dev
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://fidel:fidel@postgres:5432/fidel
TEST_DATABASE_URL=postgresql+asyncpg://fidel:fidel@postgres:5432/fidel

# Redis
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/0
HISTORY_CACHE_TTL_S=60

# JWT / Auth
JWT_SECRET=change-me-in-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=10080

# Model Inference service
INFERENCE_BASE_URL=http://inference:7890
INFERENCE_TIMEOUT_S=60.0
INFERENCE_MODEL=fidel-chat-v1-125M
INFERENCE_TEMPERATURE=0.7
INFERENCE_TOP_P=0.9
INFERENCE_TOP_K=50
INFERENCE_MAX_TOKENS=512

# Rate limiting
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
RATE_LIMIT_DEFAULT=100/minute
CHAT_RATE_LIMIT=30/minute
AUTH_RATE_LIMIT=20/minute

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
