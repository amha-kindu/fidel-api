# Environment
ENV=dev
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/fidel
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/test

# Redis
REDIS_URL=redis://localhost:6379/0
HISTORY_CACHE_TTL_S=60

# JWT / Auth
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=10080

# Model Inference service
INFERENCE_BASE_URL=http://inference:8001
INFERENCE_TIMEOUT_S=60.0

# Rate limiting
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=100/minute
CHAT_RATE_LIMIT=30/minute
AUTH_RATE_LIMIT=20/minute
